# AI ERA: TEKNOLOJİ & GİRİŞİMCİLİK ZİRVESİ (Aura Bilgi Yarışması)
# Çevre Değişkenleri Konfigürasyonu

# Güvenlik & Oda Ayarları
ADMIN_PIN=220126
STAGE_PIN=220126
DEFAULT_ROOM_PIN=2026

# Google Gemini API (30 Özgün Soru Üretimi İçin)
# Google AI Studio'dan alabilirsiniz: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Firebase Admin SDK (Sunucu Tarafı Firestore Senkronizasyonu)
# Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Firebase Web Client (Tarayıcı Tarafı Firestore Canlı Dinleyici - İsteğe Bağlı)
# Firebase Console -> Project Settings -> General -> Your apps -> Web app config
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Sunucu Port & Host (Yerel geliştirme)
HOST=0.0.0.0
PORT=8000
DEBUG=False
